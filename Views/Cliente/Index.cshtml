@model IReadOnlyList<CotizadorIA.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Clientes</h1>
        <p class="text-muted mb-0">Administra clientes y factores comerciales.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo cliente</a>
</div>

@if (TempData["SuccessMessage"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<div class="table-responsive card">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Cliente</th>
                <th>Código SAP</th>
                <th>Categoría</th>
                <th>Factor general</th>
                <th>Factor Streamline</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>
                    <strong>@cliente.Nombre</strong>
                    @if (!string.IsNullOrWhiteSpace(cliente.Direccion))
                    {
                        <div class="small text-muted">@cliente.Direccion</div>
                    }
                </td>
                <td>@(cliente.CodigoSap ?? "—")</td>
                <td>@(cliente.Categoria?.ToString() ?? "Sin categoría")</td>
                <td>@(cliente.FactorGeneral?.ToString("P2") ?? "—")</td>
                <td>@(cliente.FactorStreamline?.ToString("P2") ?? "—")</td>
                <td>
                    <span class="badge @(cliente.Activo ? "text-bg-success" : "text-bg-secondary")">
                        @(cliente.Activo ? "Activo" : "Inactivo")
                    </span>
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted py-4">Aún no hay clientes registrados.</td></tr>
        }
        </tbody>
    </table>
</div>
