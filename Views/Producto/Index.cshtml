@model IReadOnlyList<CotizadorIA.Models.Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Productos</h1>
        <p class="text-muted mb-0">Administra el catálogo, sus precios y disponibilidad.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo producto</a>
</div>

@if (TempData["SuccessMessage"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<div class="table-responsive card">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>SKU</th>
                <th>Descripción</th>
                <th>Familia / subfamilia</th>
                <th>Unidad</th>
                <th class="text-end">Precio de lista</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td class="text-nowrap">@producto.CodigoCatalogo</td>
                <td>@producto.Descripcion</td>
                <td>@producto.Subfamilia.Familia.Nombre / @producto.Subfamilia.Nombre</td>
                <td>@producto.Unidad</td>
                <td class="text-end">@producto.PrecioLista.ToString("N2")</td>
                <td>
                    <span class="badge @(producto.Activo ? "text-bg-success" : "text-bg-secondary")">
                        @(producto.Activo ? "Activo" : "Inactivo")
                    </span>
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted py-4">Aún no hay productos registrados.</td></tr>
        }
        </tbody>
    </table>
</div>
