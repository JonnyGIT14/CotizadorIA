@{
    ViewData["Title"] = "Login";
}

<h2>Iniciar Sesión</h2>

<form method="post">
    <div>
        <label>Email</label>
        <input type="email" name="Email" />
    </div>

    <div>
        <label>Contraseña</label>
        <input type="password" name="Password" />
    </div>

    <button type="submit">
        Ingresar
    </button>
</form>